# ---- THEME & COLORS ----
# A gorgeous dark theme that eliminates eye strain
theme = Catppuccin-Mocha

# ---- TYPOGRAPHY (Crucial for Readability) ----
# Uses macOS's premium native programming font
font-family = "SF Mono"
font-size = 13.5
font-thicken = true

# ---- SPACING & PADDING (Gives your text room to breathe) ----
# This stops text from hugging the very edges of the window
window-padding-x = 14
window-padding-y = 14
line-height = 1.3

# ---- WINDOW CLEANLINESS ----
# Removes the ugly top title bar for a completely seamless look
macos-titlebar-style = hidden
background-opacity = 0.98

# ---- CURSOR CUSTOMIZATION ----
# Makes your blinking cursor instantly recognizable
cursor-style = block
cursor-blink = true

